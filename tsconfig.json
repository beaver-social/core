{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",

    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@beaver/react": ["packages/lib/beaver-react/src"],
      "@beaver/react/*": ["packages/lib/beaver-react/src/*"],
      "@beaver/client": ["packages/lib/beaver-client/src"],
      "@beaver/client/*": ["packages/lib/beaver-client/src/*"]
    }
  },
  "include": ["packages/**/*"]
}
