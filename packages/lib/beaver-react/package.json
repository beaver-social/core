{
  "name": "@beaver/react",
  "version": "0.1.0",
  "description": "React SDK for integrating with Beaver Social - Complete wrapper for @beaver/client",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beaver-social",
    "directory": "packages/lib/beaver-react"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "build:all": "cd ../beaver-client && bun run build && cd ../beaver-react && bun run build",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.42.0",
    "eslint-config-react-app": "^7.0.1",
    "tsup": "^6.7.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@beaver/client": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
