{
  "name": "@beaver/client",
  "version": "0.0.1",
  "description": "The Beaver Social Client for interacting with Beaver Social",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/beaver-social",
    "directory": "packages/lib/client"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap",
    "dev": "bun run build --watch",
    "docs": "typedoc --out docs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsconfig": "*",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.779.0",
    "@hono/client": "^0.0.3",
    "server": "workspace:*",
    "contracts": "workspace:*"
  }
}
